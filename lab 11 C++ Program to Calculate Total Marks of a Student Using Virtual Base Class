
#include <iostream>
using namespace std;

// Base Class
class Student
{
protected:
    int roll;
    char name[50];

public:
    void getStudent()
    {
        cout << "Enter Roll Number: ";
        cin >> roll;

        cout << "Enter Name: ";
        cin >> name;
    }
};

// First Derived Class
class Test : virtual public Student
{
protected:
    int marks1, marks2;

public:
    void getMarks()
    {
        cout << "Enter marks of two subjects: ";
        cin >> marks1 >> marks2;
    }
};

// Second Derived Class
class Sports : virtual public Student
{
protected:
    int sportsMarks;

public:
    void getSports()
    {
        cout << "Enter sports marks: ";
        cin >> sportsMarks;
    }
};

// Final Derived Class
class Result : public Test, public Sports
{
    int total;

public:
    void calculate()
    {
        total = marks1 + marks2 + sportsMarks;
    }

    void display()
    {
        cout << "\n----- STUDENT RESULT -----";
        cout << "\nRoll Number: " << roll;
        cout << "\nName: " << name;
        cout << "\nTotal Marks: " << total;
    }
};

int main()
{
    Result r;

    r.getStudent();
    r.getMarks();
    r.getSports();
    r.calculate();
    r.display();

    return 0;
}

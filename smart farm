Employee Name: Amit
Salary: 25000

3 Write a C++ program to demonstrate the use of multiple objects of the same class.
Answer:
Multiple objects are instances of the same class. Each object has its own separate copy of the data members.

#include <iostream>
using namespace std;

class Student
{
    int roll;
    char name[50];

public:
    void getData()
    {
        cout << "Enter Roll Number: ";
        cin >> roll;

        cout << "Enter Name: ";
        cin >> name;
    }

    void display()
    {
        cout << "\nRoll Number: " << roll;
        cout << "\nName: " << name << endl;
    }
};

int main()
{
    Student s1, s2, s3;

    cout << "Enter details of Student 1:\n";
    s1.getData();

    cout << "\nEnter details of Student 2:\n";
    s2.getData();

    cout << "\nEnter details of Student 3:\n";
    s3.getData();

    cout << "\nStudent Details:\n";

    s1.display();
    s2.display();
    s3.display();

    return 0;
}
output-
Enter details of Student 1:
Enter Roll Number: 1
Enter Name: Rahul

Enter details of Student 2:
Enter Roll Number: 2
Enter Name: Amit

Enter details of Student 3:
Enter Roll Number: 3
Enter Name: Raj

Student Details:

Roll Number: 1
Name: Rahul

Roll Number: 2
Name: Amit

Roll Number: 3
Name: Raj





